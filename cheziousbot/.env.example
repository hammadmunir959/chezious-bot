# ── LLM ──────────────────────────────────────────
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cheziousbot

# ── Redis / Checkpointer ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── Agent Tuning ──────────────────────────────────
SUMMARIZE_TOKEN_THRESHOLD=3000
RECENT_CONTEXT_MESSAGES=10
MAX_CONFIRMATION_RETRIES=2
MAX_EXTRACTION_RETRIES=3
MAX_LLM_RETRIES=2

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_DEFAULT="30 per minute"

# ── App ───────────────────────────────────────────
PROJECT_NAME="CheziousBot API"
VERSION=1.0.0
LOG_LEVEL=INFO
